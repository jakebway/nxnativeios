@@ -25,6 +27,21 @@ void front_ios_focus_event(int ev);
 
 static char *g_argv[4]; static int g_argc;
 
+// NXBuilder: a game built on the iPhone carries its rewritten modules in Frameworks/NXGame.framework (tools/mkgameframework.py) instead of in this executable.
+// Load it and point the loader at it (front.h dm_set_game_image_header) before the host's preload reads any module section.
+static void nxgame_framework_load(void) {
+    NSString *fw = [[NSBundle.mainBundle.privateFrameworksPath stringByAppendingPathComponent:@"NXGame.framework"] stringByAppendingPathComponent:@"NXGame"];
+    if (![NSFileManager.defaultManager fileExistsAtPath:fw]) return;
+    if (!dlopen(fw.fileSystemRepresentation, RTLD_NOW | RTLD_LOCAL)) { fprintf(stderr, "[RED] boot: NXGame.framework: %s\n", dlerror()); return; }
+    char want[PATH_MAX]; if (!realpath(fw.fileSystemRepresentation, want)) return;
+    for (uint32_t i = 0; i < _dyld_image_count(); i++) {
+        char got[PATH_MAX]; const char *n = _dyld_get_image_name(i);
+        if (n && realpath(n, got) && !strcmp(got, want)) { dm_set_game_image_header(_dyld_get_image_header(i)); fprintf(stderr, "boot: game modules from NXGame.framework\n"); return; }
+    }
+    fprintf(stderr, "[RED] boot: NXGame.framework loaded but its image was not found\n");
+}
+
+
 // Documents/romfs.img, one RomFS image file (dm/tools/romfs_image.py, scripts/push_romfs.sh): only a complete one counts. Its index is written last and ends the file, so a copy cut off partway is skipped
 static int romfs_image_complete(NSString *path) {
     romfs_img *m = romfs_image_open(path.fileSystemRepresentation);
@@ -185,6 +202,7 @@ static int boot_env(void) {
     if ([fm fileExistsAtPath:pso]) setenv("DM_PSO_BUNDLE", pso.fileSystemRepresentation, 0);
     chdir(doc.fileSystemRepresentation);
     g_argv[0] = strdup("dmhost"); g_argv[1] = strdup(dm.fileSystemRepresentation); g_argc = 2;
+    nxgame_framework_load();
     dm_host_preload_start(g_argc, g_argv);   // Module tables / relocation / takeover run early in the background, in parallel with UIKit startup (and the launcher: the settings it sets are read when the game starts)
     return 1;
 }
