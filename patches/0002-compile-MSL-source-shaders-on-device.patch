+// nxnativeios: a shader built on the iPhone has no offline Metal compiler, so its "library" file holds the MSL source (the builder writes it in place of the .metallib).
+// A file that does not start with the metallib magic is compiled here, with the iOS chain's flags (dm/ios/tools/ios_metal.py METAL) that have a runtime equivalent:
+// -fmetal-math-mode=relaxed (mathMode), -fpreserve-invariance (preserveInvariance), -mios-version-min=18.0 (Metal 3.2). -O1, -fwrapv and -fbracket-depth have none:
+// see nxnativeios docs/DESIGN.md. Metal keeps compiled source in its own cache.
+static id<MTLLibrary> lib_from_data(dispatch_data_t d, NSError **err) {
+    // The data is one mapping (lib_from_file_), so the map is the same bytes, not a copy
+    const void *buf = NULL; size_t len = 0; dispatch_data_t flat = dispatch_data_create_map(d, &buf, &len);
+    if (len >= 4 && !memcmp(buf, "MTLB", 4)) return [g_dev newLibraryWithData:flat error:err];
+    NSString *src = [[NSString alloc] initWithBytes:buf length:len encoding:NSUTF8StringEncoding];
+    if (!src) { if (err) *err = [NSError errorWithDomain:@"nxnativeios" code:1 userInfo:@{NSLocalizedDescriptionKey: @"shader file is neither a metallib nor UTF-8 MSL"}]; return nil; }
+    static MTLCompileOptions *opt; static dispatch_once_t once;
+    dispatch_once(&once, ^{ opt = [MTLCompileOptions new]; opt.preserveInvariance = YES; opt.mathMode = MTLMathModeRelaxed; opt.languageVersion = MTLLanguageVersion3_2; });
+    static _Atomic long n_src; long k = atomic_fetch_add(&n_src, 1);
+    if (!k) MLOG("shaders: compiling MSL source on this device (nxnativeios build)");
+    return [g_dev newLibraryWithSource:src options:opt error:err];
+}
 static id<MTLLibrary> lib_from_file_(NSString *path, NSError **err);
 static id<MTLLibrary> lib_from_file(NSString *path, NSError **err) { return lib_tag(lib_from_file_(path, err), lib_name(path)); }
 static id<MTLLibrary> lib_from_file_(NSString *path, NSError **err) {
