<!-- nxnativeios: nxnative's dm/tools/nx_extract built as a NativeAOT shared library (ios-arm64 for the app, osx-arm64 for the CI test).
     UPSTREAM = an nxnative checkout; ci/prepare_upstream.sh makes P.Main internal so Exports.cs can call it. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <PublishAotUsingRuntimePack>true</PublishAotUsingRuntimePack>
    <AssemblyName>NxExtract</AssemblyName>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <UPSTREAM Condition="'$(UPSTREAM)' == ''">$(MSBuildThisFileDirectory)../../upstream</UPSTREAM>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(UPSTREAM)/dm/tools/nx_extract/Program.cs" Link="Program.cs" />
    <!-- the same resources as upstream, so nx_extract_main("source-sha" option) matches build_ipa_from_nsp.py's nx_extract_source_sha -->
    <EmbeddedResource Include="$(UPSTREAM)/dm/tools/nx_extract/Program.cs.orig" LogicalName="src0" />
    <EmbeddedResource Include="$(UPSTREAM)/dm/tools/nx_extract/nx_extract.csproj" LogicalName="src1" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="LibHac" Version="0.19.0" />
  </ItemGroup>
</Project>
